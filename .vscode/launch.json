{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 Feishu Markdown Viewer VS Code 扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/out/**/*.js"
      ],
      "preLaunchTask": "npm: build:vscode"
    }
  ]
}
