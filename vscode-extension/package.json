{
  "name": "feishu-md-viewer-vscode",
  "displayName": "Feishu Markdown Viewer",
  "publisher": "JQQQQQQQ",
  "version": "0.1.6",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/JQQQQQQQ/feishu-md-viewer.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCustomEditor:feishu-md-viewer.markdownPreview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "feishu-md-viewer.reopenWithTextEditor",
        "title": "\u4f7f\u7528\u539f\u751f\u6587\u672c\u7f16\u8f91\u5668\u91cd\u65b0\u6253\u5f00"
      }
    ],
    "customEditors": [
      {
        "viewType": "feishu-md-viewer.markdownPreview",
        "displayName": "Feishu Markdown Preview",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ]
  }
}
